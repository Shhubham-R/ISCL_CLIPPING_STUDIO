{
  "name": "iscl-clip-studio",
  "productName": "ISCL Clip Studio",
  "version": "1.0.0",
  "description": "Professional Windows Desktop Application for Live Cricket Video Capture, Manual Clip Extraction and Social Media Content Production",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron electron/main.cjs",
    "client:build": "npm.cmd --prefix client run build",
    "build": "npm.cmd --prefix client run build",
    "dist:win": "npm.cmd run build && electron-builder --win --x64",
    "dist:portable": "npm.cmd run build && electron-builder --win portable --x64"
  },
  "keywords": [
    "iscl",
    "cricket",
    "video-editor",
    "clip-extraction",
    "ffmpeg",
    "reels"
  ],
  "author": "Indian Softball Cricket League (ISCL)",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.iscl.clipstudio",
    "productName": "ISCL Clip Studio",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "server/public/logos/iscl_logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "ISCL Clip Studio",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "client/dist/**/*"
    ]
  }
}
